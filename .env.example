# ---------- Supabase ----------
# Dashboard -> Project Settings -> API (or "API Keys"). Verify which key names your dashboard shows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public key: the legacy "anon" key, or the newer "publishable" key if your dashboard uses that
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Legacy "service_role" key, or the newer "secret" key. Server only, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for uploads (created in Phase 1)
SUPABASE_STORAGE_BUCKET=heritage-uploads

# ---------- Provider keys (server only) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# ---------- OpenAI-compatible endpoints (verify in each provider's docs) ----------
NVIDIA_BASE_URL=
GROQ_BASE_URL=

# ---------- Model IDs (copy exact strings from each provider's dashboard/catalog) ----------
GEMINI_MODEL_OCR=
NVIDIA_MODEL_EXTRACT=
GROQ_MODEL_QUERY_PARSE=
GEMINI_MODEL_EMBED=
# Must match vector(768) in the schema. Verify your embedding model can output 768 dims.
EMBED_DIMENSIONS=768

# ---------- Geocoding ----------
# Nominatim requires an identifying User-Agent, e.g. "Dharohar/0.1 (you@example.com)"
NOMINATIM_USER_AGENT=

# ---------- Map ----------
# Style JSON URL for your free OSM-based tile provider (decided in the map phase)
NEXT_PUBLIC_MAP_STYLE_URL=

# ---------- LLM routing ----------
# Provider order per task. A provider with no key, base URL or model for that task is skipped.
LLM_CHAIN_OCR=gemini,nvidia,groq
LLM_CHAIN_EXTRACT=nvidia,groq,gemini
LLM_CHAIN_QUERY_PARSE=groq,nvidia,gemini
# Embeddings have no chain: always Gemini, one model, 768 dims.

# ---------- Model IDs (copy exact strings from each dashboard) ----------
GEMINI_MODEL_OCR=
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_QUERY_PARSE=
GEMINI_MODEL_EMBED=
NVIDIA_MODEL_OCR=        # only if you have a vision-capable model; otherwise leave blank
NVIDIA_MODEL_EXTRACT=
NVIDIA_MODEL_QUERY_PARSE=
GROQ_MODEL_OCR=          # only if you have a vision-capable model; otherwise leave blank
GROQ_MODEL_EXTRACT=
GROQ_MODEL_QUERY_PARSE=

# Optional: Gemini base URL override (defaults to the Google v1beta endpoint)
GEMINI_BASE_URL=
# Must be set so that <BASE_URL>/chat/completions is the endpoint:
NVIDIA_BASE_URL=
GROQ_BASE_URL=

# ---------- Optional tuning ----------
LLM_TIMEOUT_MS=20000
LLM_TOTAL_BUDGET_MS=25000
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE_MS=500
EMBED_BATCH_SIZE=16
LLM_MAX_OUTPUT_TOKENS=
GEMINI_JSON_MODE=true
NVIDIA_JSON_MODE=true
GROQ_JSON_MODE=true
# ---------- Extract stage ----------
EXTRACT_CHUNK_CHARS=3500
EXTRACT_MAX_CHUNKS=6
EXTRACT_CONCURRENCY=2
EXTRACT_STAGE_BUDGET_MS=45000
EXTRACT_SEARCH_CHUNK_CHARS=1000
EXTRACT_UNCERTAIN_BELOW_PCT=60
# Set to false to keep uploads as drafts after the pipeline finishes
AUTO_PUBLISH=true